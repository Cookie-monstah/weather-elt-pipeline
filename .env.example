# Fixes the Docker Compose project/network name regardless of which folder
# this file lives in (the DAG references the network by this exact name).
COMPOSE_PROJECT_NAME=weather-etl-pipeline

# Open-Meteo (https://open-meteo.com/) — free, no API key required
WEATHER_CITIES=New York,London,Tokyo

# Days back from today to pull historical actuals for (feeds daily actuals +
# forecast-accuracy comparisons). 1 = yesterday.
HISTORICAL_BACKFILL_DAYS=1

# Postgres (app database, holds raw + dbt-transformed weather data)
POSTGRES_DB=db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Postgres (Airflow metadata database)
AIRFLOW_DB=airflow_db
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Postgres (Superset metadata database)
SUPERSET_DB=superset_db
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset

# Superset app
SUPERSET_SECRET_KEY=changeme
SUPERSET_PORT=8088
SUPERSET_LOG_LEVEL=info
SUPERSET_LOAD_EXAMPLES=no
